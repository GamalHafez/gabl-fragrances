generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
// ______________________________________

enum Role {
  CUSTOMER
  ADMIN
}

enum Weather {
  SUMMER
  WINTER
  SPRING
  AUTUMN
  ALL_SEASONS
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

// USER
// ______________________________________

model User {
  id       String @id @default(uuid())
  name     String @db.VarChar(100)
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  role     Role   @default(CUSTOMER)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CATALOG
// ______________________________________

model Category {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(120)

  // Relationships
  products Product[]

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  // Basic product information
  id          String  @id @default(uuid())
  slug        String  @unique @db.VarChar(150)
  name        String  @db.VarChar(150)
  description String  @db.Text
  gender      Gender
  inspiredBy  String? @db.VarChar(100)

  // Fragrance profile
  topNotes  String[]
  midNotes  String[]
  baseNotes String[]
  vibes     String   @db.VarChar(255)

  // Marketing flags
  isBestSeller Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  categories Category[]
  images     ProductImage[]
  variants   ProductVariant[]
}

model ProductImage {
  id          String  @id @default(uuid())
  url         String  @unique @db.Text
  description String? @db.VarChar(100)

  // Main img of the product
  isMain Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductVariant {
  id     String  @id @default(uuid())
  sizeML Int     @default(50) @db.SmallInt
  stock  Int     @default(0)
  price  Decimal @db.Decimal(10, 2)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, sizeML])
  @@index([productId])
}
