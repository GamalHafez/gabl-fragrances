generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
// ______________________________________

enum Weather {
  SUMMER
  WINTER
  SPRING
  AUTUMN
  ALL_SEASONS
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
}

enum InventoryTransactionType {
  RESTOCK
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
}

// USER
// ______________________________________

model User {
  id       String @id @default(uuid())
  name     String @db.VarChar(100)
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  refreshTokens RefreshToken[]
}

// RBAC models
// ______________________________________

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id   Int    @id @default(autoincrement())
  name String @unique

  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// Product
// ______________________________________

model Product {
  // Basic product information
  id          String  @id @default(uuid())
  slug        String  @unique @db.VarChar(150)
  name        String  @db.VarChar(150)
  description String  @db.Text
  gender      Gender
  inspiredBy  String? @db.VarChar(100)

  // Fragrance profile
  topNotes    String[]
  midNotes    String[]
  baseNotes   String[]
  vibes       String    @db.VarChar(255)
  bestSeasons Weather[]

  // Marketing flags
  isBestSeller Boolean @default(false)
  isNew        Boolean @default(false)

  // Availability
  isActive Boolean @default(true)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]
}

model ProductImage {
  id          String  @id @default(uuid())
  url         String  @unique @db.Text
  description String? @db.VarChar(100)
  publicId    String  @unique

  // Main img of the product
  isMain Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductVariant {
  id     String  @id @default(uuid())
  label  String? @db.VarChar(100)
  sizeML Int     @db.SmallInt
  stock  Int     @default(0)
  price  Decimal @db.Decimal(10, 2)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Availability
  isActive Boolean @default(true)

  // Relationships
  productId             String
  product               Product                @relation(fields: [productId], references: [id])
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([productId, label, sizeML])
  @@index([productId])
}

// ORDERS
// ______________________________________

model ShippingMethod {
  id          String  @id @default(uuid())
  name        String  @unique @db.VarChar(150)
  description String  @db.Text
  price       Decimal @db.Decimal(10, 2)

  // Availability
  isActive Boolean @default(true)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  orders Order[]
}

model Address {
  id          String  @id @default(uuid())
  address     String  @db.VarChar(255)
  country     String  @db.VarChar(50)
  city        String  @db.VarChar(50)
  governorate String  @db.VarChar(50)
  postalCode  String? @db.VarChar(20)
  isDefault   Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  userId String
  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
}

model Discount {
  id    String       @id @default(uuid())
  code  String       @unique @db.VarChar(50)
  type  DiscountType
  value Decimal      @db.Decimal(10, 2)

  isActive Boolean @default(true)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  orders Order[]
}

model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique
  status      OrderStatus @default(PENDING)

  subTotal Decimal @db.Decimal(10, 2)
  shipping Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Customer information
  customerName  String @db.VarChar(100)
  customerEmail String @db.VarChar(255)
  customerPhone String @db.VarChar(30)

  // Billing address
  // When billingSameAsShipping is true,
  // these fields can remain null because the shipping
  // address snapshot is used as the billing address.
  billingSameAsShipping Boolean @default(true)

  billingAddress     String? @db.VarChar(255)
  billingCity        String? @db.VarChar(50)
  billingGovernorate String? @db.VarChar(50)
  billingCountry     String? @db.VarChar(50)
  billingPostalCode  String? @db.VarChar(20)

  // Optional registered account
  userId String?

  // Original saved address used for this order
  addressId String?

  // Discount reference
  discountId String?

  // Shipping address snapshot
  shippingAddress     String  @db.VarChar(255)
  shippingCity        String  @db.VarChar(50)
  shippingGovernorate String  @db.VarChar(50)
  shippingCountry     String  @db.VarChar(50)
  shippingPostalCode  String? @db.VarChar(20)

  // Shipping method snapshot
  shippingMethodId    String?
  shippingMethodName  String?  @db.VarChar(150)
  shippingMethodPrice Decimal? @db.Decimal(10, 2)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user                  User?                  @relation(fields: [userId], references: [id])
  address               Address?               @relation(fields: [addressId], references: [id])
  discount              Discount?              @relation(fields: [discountId], references: [id])
  items                 OrderItem[]
  payments              Payment[]
  inventoryTransactions InventoryTransaction[]
  shippingMethod        ShippingMethod?        @relation(fields: [shippingMethodId], references: [id])

  @@index([userId])
  @@index([addressId])
  @@index([discountId])
  @@index([shippingMethodId])
}

model OrderItem {
  id               String  @id @default(uuid())
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  orderId          String
  productVariantId String

  // Product snapshot
  productName String @db.VarChar(150)
  sizeML      Int    @db.SmallInt

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
}

// ContactMessage
// ______________________________________

model ContactMessage {
  id      String  @id @default(uuid())
  name    String  @db.VarChar(100)
  email   String  @db.VarChar(255)
  phone   String? @db.VarChar(30)
  message String  @db.Text

  isRead Boolean   @default(false)
  readAt DateTime?

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Payment
// ______________________________________

model Payment {
  id String @id @default(uuid())

  amount   Decimal @db.Decimal(10, 2)
  currency String  @db.VarChar(3)

  status PaymentStatus
  method PaymentMethod

  transactionId String? @unique @db.VarChar(255)

  // Payment provider information
  provider        String? @db.VarChar(50)
  providerOrderId String? @db.VarChar(255)

  // Track timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  // Relationships
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([orderId])
  @@index([providerOrderId])
}

// Review
// ______________________________________

model Review {
  id       String  @id @default(uuid())
  name     String  @db.VarChar(100)
  imageUrl String? @db.Text
  review   String  @db.Text
  rating   Int     @default(5)

  // For preventing spam/abusive content.
  isApproved Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional authenticated user
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Product being reviewed
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([userId])
}

// InventoryTransaction
// ______________________________________

model InventoryTransaction {
  id       String                   @id @default(uuid())
  quantity Int
  type     InventoryTransactionType
  reason   String?                  @db.VarChar(255)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  orderId          String?
  order            Order?         @relation(fields: [orderId], references: [id])

  @@index([productVariantId])
  @@index([orderId])
}

// RefreshToken
// ______________________________________

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}
