generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
// ______________________________________

enum Role {
  CUSTOMER
  ADMIN
}

enum Weather {
  SUMMER
  WINTER
  SPRING
  AUTUMN
  ALL_SEASONS
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

// USER
// ______________________________________

model User {
  id       String @id @default(uuid())
  name     String @db.VarChar(100)
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  role     Role   @default(CUSTOMER)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  addresses Address[]
  orders    Order[]
}

// CATALOG
// ______________________________________

model Category {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(120)

  // Relationships
  products Product[]

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  // Basic product information
  id          String  @id @default(uuid())
  slug        String  @unique @db.VarChar(150)
  name        String  @db.VarChar(150)
  description String  @db.Text
  gender      Gender
  inspiredBy  String? @db.VarChar(100)

  // Fragrance profile
  topNotes  String[]
  midNotes  String[]
  baseNotes String[]
  vibes     String   @db.VarChar(255)

  // Marketing flags
  isBestSeller Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  categories Category[]
  images     ProductImage[]
  variants   ProductVariant[]
}

model ProductImage {
  id          String  @id @default(uuid())
  url         String  @unique @db.Text
  description String? @db.VarChar(100)

  // Main img of the product
  isMain Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductVariant {
  id     String  @id @default(uuid())
  sizeML Int     @default(50) @db.SmallInt
  stock  Int     @default(0)
  price  Decimal @db.Decimal(10, 2)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@unique([productId, sizeML])
  @@index([productId])
}

// ORDERS
// ______________________________________

model Address {
  id          String  @id @default(uuid())
  address     String  @db.VarChar(255)
  country     String  @db.VarChar(50)
  city        String  @db.VarChar(50)
  apartment   String? @db.VarChar(50)
  governorate String  @db.VarChar(50)
  postalCode  String? @db.VarChar(20)
  isDefault   Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  userId String
  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
}

model Discount {
  id    String       @id @default(uuid())
  code  String       @unique @db.VarChar(50)
  type  DiscountType
  value Decimal      @db.Decimal(10, 2)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  orders Order[]
}

model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique
  status      OrderStatus @default(PENDING)
  subTotal    Decimal     @db.Decimal(10, 2)
  shipping    Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  userId      String
  addressId   String
  discountId  String?

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Address snapshot
  shippingAddress     String
  shippingCity        String
  shippingGovernorate String
  shippingCountry     String
  shippingPostalCode  String?

  // Relationships
  user     User        @relation(fields: [userId], references: [id])
  address  Address     @relation(fields: [addressId], references: [id])
  discount Discount?   @relation(fields: [discountId], references: [id])
  items    OrderItem[]

  @@index([userId])
  @@index([addressId])
  @@index([discountId])
}

model OrderItem {
  id               String  @id @default(uuid())
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  orderId          String
  productVariantId String

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
}

// ContactMessage
// ______________________________________

model ContactMessage {
  id      String    @id @default(uuid())
  name    String    @db.VarChar(100)
  email   String    @db.VarChar(255)
  phone   String?   @db.VarChar(30)
  message String    @db.Text
  
  isRead  Boolean   @default(false)
  readAt  DateTime?

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
