generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
// ______________________________________

enum Role {
  CUSTOMER
  ADMIN
}

enum Weather {
  SUMMER
  WINTER
  SPRING
  AUTUMN
  ALL_SEASONS
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
}

// USER
// ______________________________________

model User {
  id       String @id @default(uuid())
  name     String @db.VarChar(100)
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  role     Role   @default(CUSTOMER)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  addresses Address[]
  orders    Order[]
  reviews   Review[]
}

// CATALOG
// ______________________________________

model Category {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(120)

  // Relationships
  products Product[]

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  // Basic product information
  id          String  @id @default(uuid())
  slug        String  @unique @db.VarChar(150)
  name        String  @db.VarChar(150)
  description String  @db.Text
  gender      Gender
  inspiredBy  String? @db.VarChar(100)

  // Fragrance profile
  topNotes    String[]
  midNotes    String[]
  baseNotes   String[]
  vibes       String    @db.VarChar(255)
  bestSeasons Weather[]

  // Marketing flags
  isBestSeller Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  categories Category[]
  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
}

model ProductImage {
  id          String  @id @default(uuid())
  url         String  @unique @db.Text
  description String? @db.VarChar(100)

  // Main img of the product
  isMain Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductVariant {
  id     String  @id @default(uuid())
  sizeML Int     @default(50) @db.SmallInt
  stock  Int     @default(0)
  price  Decimal @db.Decimal(10, 2)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@unique([productId, sizeML])
  @@index([productId])
}

// ORDERS
// ______________________________________

model Address {
  id          String  @id @default(uuid())
  address     String  @db.VarChar(255)
  country     String  @db.VarChar(50)
  city        String  @db.VarChar(50)
  apartment   String? @db.VarChar(50)
  governorate String  @db.VarChar(50)
  postalCode  String? @db.VarChar(20)
  isDefault   Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  userId String
  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
}

model Discount {
  id    String       @id @default(uuid())
  code  String       @unique @db.VarChar(50)
  type  DiscountType
  value Decimal      @db.Decimal(10, 2)

  isActive Boolean @default(true)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  orders Order[]
}

model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique
  status      OrderStatus @default(PENDING)

  subTotal Decimal @db.Decimal(10, 2)
  shipping Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Customer information
  customerName  String @db.VarChar(100)
  customerEmail String @db.VarChar(255)
  customerPhone String @db.VarChar(30)

  // Optional registered account
  userId String?

  // Original saved address used for this order
  addressId String?

  discountId String?

  // Shipping address snapshot
  shippingAddress     String  @db.VarChar(255)
  shippingCity        String  @db.VarChar(50)
  shippingGovernorate String  @db.VarChar(50)
  shippingCountry     String  @db.VarChar(50)
  shippingPostalCode  String? @db.VarChar(20)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user     User?       @relation(fields: [userId], references: [id])
  address  Address?    @relation(fields: [addressId], references: [id])
  discount Discount?   @relation(fields: [discountId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([addressId])
  @@index([discountId])
}

model OrderItem {
  id               String  @id @default(uuid())
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  orderId          String
  productVariantId String

  // Product snapshot
  productName String @db.VarChar(150)
  sizeML      Int    @db.SmallInt

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
}

// ContactMessage
// ______________________________________

model ContactMessage {
  id      String  @id @default(uuid())
  name    String  @db.VarChar(100)
  email   String  @db.VarChar(255)
  phone   String? @db.VarChar(30)
  message String  @db.Text

  isRead Boolean   @default(false)
  readAt DateTime?

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Payment
// ______________________________________

model Payment {
  id String @id @default(uuid())

  amount   Decimal @db.Decimal(10, 2)
  currency String  @db.VarChar(3)

  status PaymentStatus
  method PaymentMethod

  transactionId String? @unique @db.VarChar(255)

  // Payment provider information
  provider        String? @db.VarChar(50)
  providerOrderId String? @db.VarChar(255)

  // Track timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  // Relationships
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([orderId])
  @@index([providerOrderId])
}

// Review
// ______________________________________

model Review {
  id       String  @id @default(uuid())
  name     String  @db.VarChar(100)
  imageUrl String? @db.Text
  review   String  @db.Text
  rating   Int     @default(5)

  // For preventing spam/abusive content.
  isApproved Boolean @default(false)

  // Track timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional authenticated user
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Product being reviewed
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([userId])
}
